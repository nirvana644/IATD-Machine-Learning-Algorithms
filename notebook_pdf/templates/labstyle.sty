\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{labstyle}

% xcolor and tikz are required by week_4_lesson_3_apriori_algorithm.ipynb
\RequirePackage{xcolor}
\RequirePackage{tikz}

% Five filled markers, each occupying the same 0.8em square with a common
% baseline. Colors are supplied by the notebook via \textcolor.
\newcommand{\labfilledmarker}[1]{%
    \hbox{\tikz[x=0.8em,y=0.8em,baseline=0pt]{%
        \path[use as bounding box] (0,0) rectangle (1,1);
        \fill #1;
    }}%
}
\newcommand{\labcircle}{\labfilledmarker{(0.5,0.5) circle[radius=0.5]}}
\newcommand{\labtriangle}{\labfilledmarker{(0,0) -- (1,0) -- (0.5,1) -- cycle}}
\newcommand{\labstar}{\labfilledmarker{(0.5,1) -- (0.618,0.618)
    -- (1,0.618) -- (0.691,0.382) -- (0.809,0) -- (0.5,0.236)
    -- (0.191,0) -- (0.309,0.382) -- (0,0.618) -- (0.382,0.618) -- cycle}}
\newcommand{\labsquare}{\labfilledmarker{(0,0) rectangle (1,1)}}
\newcommand{\labpentagon}{\labfilledmarker{(0.5,1) -- (0,0.618)
    -- (0.191,0) -- (0.809,0) -- (1,0.618) -- cycle}}

% Compatibility with existing notebook equations, after unicode-math setup.
\AddToHook{begindocument/end}{%
    \let\blacktriangle\labtriangle
    \let\bigstar\labstar
    \let\pentagonblack\labpentagon
}

\RequirePackage{fancyhdr}

\fancypagestyle{labfooter}{
    \fancyhf{}
    \fancyfoot[L]{Álvaro Morán Gago}
    \fancyfoot[R]{Page \thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
}

% Also apply the footer to pages using the plain style.
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[L]{Álvaro Morán Gago}
    \fancyfoot[R]{Page \thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
}

\AtBeginDocument{\pagestyle{labfooter}}

% Compatibility fix for Pandoc tables without captions.
% This will prevent the error: ! LaTeX Error: No counter 'none' defined.
\makeatletter
\@ifundefined{c@none}{\newcounter{none}}{}
\makeatother
